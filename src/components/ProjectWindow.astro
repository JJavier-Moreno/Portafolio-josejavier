---
interface Props {
  title: string;
  liveUrl?: string;
  windowClasses?: string;
}

const { title, liveUrl, windowClasses = "" } = Astro.props;
---

<article
  class={`relative mx-auto flex w-full max-w-[18rem] flex-col overflow-hidden rounded-2xl border border-white/12 bg-black-800/80 shadow-[0_24px_60px_rgba(8,15,26,0.45)] backdrop-blur-xl transition duration-500 hover:-translate-y-1 hover:scale-[1.02] ${windowClasses}`}
>
  <div class="flex items-center justify-between w-full px-5 py-3 border-b border-white/10 bg-black-900/80">
    <div class="flex items-center gap-1.5">
      <span class="w-3 h-3 rounded-full bg-red-400/80"></span>
      <span class="w-3 h-3 rounded-full bg-yellow-400/80"></span>
      <span class="w-3 h-3 rounded-full bg-green-400/80"></span>
    </div>
    <p class="text-sm font-medium text-gray-300 truncate max-w-[55%]">{title}</p>
    <span class="hidden text-[10px] uppercase tracking-[0.35em] text-gray-500 sm:block">preview</span>
  </div>

  <div class="relative flex-1 min-h-[160px] bg-black-900">
    {liveUrl ? (
      <iframe
        src={liveUrl}
        class="absolute inset-0 w-full h-full border-0"
        loading="lazy"
        referrerpolicy="no-referrer"
      ></iframe>
    ) : (
      <slot>
        <div class="flex items-center justify-center w-full h-full text-xs tracking-wide text-gray-500 uppercase"></div>
      </slot>
    )}
  </div>
</article>
