<header class="sticky top-0 z-40 text-white">
  <!-- Fondo translúcido desenfocado -->
  <div class="absolute inset-0 z-0 w-full h-full transition-opacity bg-background/90 dark:bg-background/95 backdrop-blur-sm"></div>

  <!-- Contenedor principal del header -->
  <nav class="relative z-10 border-b border-border-default">
    <div class="relative flex items-center justify-between h-16 px-6 mx-auto lg:container lg:px-16 xl:px-20">
      
      <!-- Logo + Navegación -->
      <div class="flex items-center justify-between flex-1 sm:items-stretch">

        <!-- Logo -->
        <div class="flex items-center justify-center flex-shrink-0">
          <a href="/" class="block w-auto h-6 text-lg font-semibold">Moreno<span class="text-green-500">Dev</span></a>
        </div>

        <!-- Navegación principal -->
        <nav class="items-center flex-1 pl-8 lg:flex">
          <ul class="flex items-center justify-center space-x-4 list-none">
            <li><a href="#inicio" class="text-sm font-medium transition-colors hover:text-green-400">Inicio</a></li>
            <li><a href="#sobre-mi" class="text-sm font-medium transition-colors hover:text-green-400">Sobre mí</a></li>
            <li><a href="#experiencia" class="text-sm font-medium transition-colors hover:text-green-400">Experiencia</a></li>
            <li><a href="#proyectos" class="text-sm font-medium transition-colors hover:text-green-400">Proyectos</a></li>
            <li><a href="#contacto" class="text-sm font-medium transition-colors hover:text-green-400">Contacto</a></li>
          </ul>
        </nav>

        <!-- Redes sociales o iconos -->
        <div class="flex items-center space-x-4">
          <a href="#" class="hover:text-green-400">Icono</a>
          <a href="#" class="hover:text-green-400">Icono</a>
          <a href="#" class="hover:text-green-400">Icono</a>
        </div>

      </div>
    </div>
  </nav>
</header>
