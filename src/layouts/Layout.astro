---
import "../styles/global.css";
import Header from "../components/Header.jsx";
import Sobremi from "../components/Sobremi.jsx";
import ChatBot from "../components/Chatbot.jsx";
import RotatingText from "../components/RotatingText";
import ScrollFloat from "../components/ScrollFloat.jsx";
import Tecnologias from "../components/Tecnologias.jsx";
import LiquidEther from "../components/LiquidEther.jsx";
import { projects } from "../lib/projects";
import ProjectWindow from "../components/ProjectWindow.astro";
const zIndices = ["md:z-30", "md:z-40", "md:z-20", "md:z-10"];
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans bg-black-900">
    <Header client:load />
    <main class="relative min-h-screen" id="inicio">
      <section class="relative mt-14 md:mt-0">
        <div class="absolute inset-0 overflow-hidden -z-10">
  <LiquidEther
  client:load
    colors={[ '#5227FF', '#FF9FFC', '#B19EEF' ]}
    mouseForce={20}
    cursorSize={100}
    isViscous={false}
    viscous={30}
    iterationsViscous={32}
    iterationsPoisson={32}
    resolution={0.5}
    isBounce={false}
    autoDemo={true}
    autoSpeed={0.5}
    autoIntensity={2.2}
    takeoverDuration={0.25}
    autoResumeDelay={3000}
    autoRampDuration={0.6}
  />

          <div
            class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/40 to-black/90 backdrop-blur-[2px] pointer-events-none"
            aria-hidden="true"
          ></div>
        </div>
        <div
          class="container relative px-6 py-12 mx-auto md:py-20 lg:px-16 xl:px-20"
        >
          <div class="relative">
            <div class="mx-auto">
              <div
                class="flex justify-center mx-auto text-center max-w-1xl md:max-w-3xl"
              >
                <div class="relative flex flex-col items-center">
                  <!-- Degradado radial verde claro, detrás del texto -->
                  <div
                    class="absolute inset-0 flex items-center justify-center pointer-events-none -z-10"
                    aria-hidden="true"
                  >
                    <div
                      class="w-[200px] h-[200px] md:w-[600px] md:h-[600px] rounded-full
      bg-[radial-gradient(circle,rgba(34,197,94,0.16)_0%,rgba(34,197,94,0.07)_20%,rgba(34,197,94,0)_60%)]"
                      style="top: 50%; left: 50%; transform: translate(-50%, -45%); position: absolute;"
                    >
                    </div>
                  </div>
                  <div class="flex flex-col items-center">
                    <h1
                      class="text-4xl font-semibold text-center text-white sm:text-5xl md:text-6xl xl:text-7xl"
                    >
                      <span class="block text-foreground">
                        Jose Javier Moreno
                      </span>
                      <span
                        class="relative inline-block w-[180px] md:w-[500px] h-[42px] md:h-[80px]"
                      >
                        <div
                          class="absolute inset-0 flex items-center justify-center gap-1 mt-1 md:gap-2"
                        >
                          Desarrollador
                          <RotatingText
                            client:load
                            texts={["Frontend", "Backend", "FullStack"]}
                            mainClassName="w-full h-full px-2 md:px-3 bg-green-400 text-black py-1 md:py-1 justify-center rounded-lg text-center whitespace-nowrap"
                            staggerFrom="last"
                            initial={{ y: "100%" }}
                            animate={{ y: 0 }}
                            exit={{ y: "-120%" }}
                            staggerDuration={0.025}
                            splitLevelClassName="overflow-hidden"
                            transition={{
                              type: "spring",
                              damping: 30,
                              stiffness: 400,
                            }}
                            rotationInterval={2300}
                          />
                        </div>
                      </span>
                    </h1>
                    <p class="pt-4 my-4 text-base leading-relaxed text-gray-200 sm:text-lg lg:text-xl">
                      Hola, soy Jose Javier. Desarrollador de software fullstack
                      con 2 años de experiencia. Me encanta crear soluciones
                      atractivas e innovadoras. Así como aplicaciones que ayuden
                      a mejorar la vida de las personas.
                    </p>
                  </div>
                  <div class="flex items-center justify-center gap-4 mt-10">
                    <a
                      class="relative flex inline-flex justify-center px-5 py-2 space-x-2 text-sm font-medium text-center text-white transition-all duration-200 ease-out border rounded-md outline-none md:px-5 md:py-3 md:text-base bg-verde-btn-700 border-verde-btn-600 hover:bg-verde-btn-500 focus-visile:outline-4 focus:visible:outline-offset-1 focus-visible:ouline-green-600"
                      href="/images/CV - Jose Javier Moreno Clavijos.pdf"
                      class="btn btn-primary"
                      download>Descargar CV</a
                    >
                    <a
                      class="relative flex inline-flex justify-center px-5 py-2 space-x-2 text-sm font-medium text-center text-white transition-all duration-200 ease-out border border-green-100 rounded-md outline-none md:text-base md:px-5 bg-verde-btn-400 focus-visile:outline-4 focus:visible:outline-offset-1 focus-visible:ouline-green-600"
                      href="#">Contactar</a
                    >
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="overflow-hidden">
            <div class="max-w-2xl mx-auto mt-16 md:mt-20 fade-mask">
              <div
                class="flex space-x-8 text-white animate-marquee2 whitespace-nowrap lg:px-8"
              >
                <span class="text-sm sm:text-base md:text-lg">🔍 Detallista</span>
                <span class="text-sm sm:text-base md:text-lg">💡 Creativo</span>
                <span class="text-sm sm:text-base md:text-lg">⚡ Proactivo</span>
                <span class="text-sm sm:text-base md:text-lg">🛠️ Resolutivo</span>
                <span class="text-sm sm:text-base md:text-lg">🧠 Autodidacta</span>
                <span class="text-sm sm:text-base md:text-lg">🔍 Detallista</span>
                <span class="text-sm sm:text-base md:text-lg">💡 Creativo</span>
                <span class="text-sm sm:text-base md:text-lg">⚡ Proactivo</span>
                <span class="text-sm sm:text-base md:text-lg">🛠️ Resolutivo</span>
                <span class="text-sm sm:text-base md:text-lg">🧠 Autodidacta</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div
        class="container relative px-5 py-12 mx-auto md:py-20 md:px-14 lg:px-16 xl:px-20"
      >
        <Sobremi client:load />
      </div>

      <div
        class="container relative py-12 mx-auto px-7 md:py-20 md:px-14 lg:py-24 lg:px-20 xl:px-10"
      >
        <section class="relative flex flex-col items-center" id="proyectos">
          <ScrollFloat client:load text="Proyectos"></ScrollFloat>

          <div
            class="grid w-full gap-12 mt-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)] lg:items-center"
          >
            <div class="space-y-6 text-center lg:text-left">
              <div class="space-y-4">
                <h2 class="text-3xl font-semibold text-white md:text-4xl">
                  Proyectos destacados
                </h2>
                <p class="max-w-2xl mx-auto text-base leading-relaxed text-gray-300 lg:mx-0">
                  Diseñé experiencias enfocadas en negocio y conversiones. Cada proyecto combina un enfoque visual cuidado con
                  rendimiento, accesibilidad y contenido editable por el cliente.
                </p>
              </div>

              <div class="grid gap-6">
                {projects.map((project) => (
                  <article
                    class="p-6 text-left transition border rounded-2xl border-white/10 bg-black-800/70 backdrop-blur-sm hover:border-green-400/50 hover:shadow-[0_18px_40px_rgba(34,197,94,0.18)]"
                  >
                    <div
                      class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between sm:gap-6"
                    >
                      <div>
                        <h3 class="text-xl font-semibold text-white sm:text-2xl">
                          {project.title}
                        </h3>
                        <p class="mt-2 text-sm leading-relaxed text-gray-400 sm:text-base">
                          {project.description}
                        </p>
                      </div>
                      <a
                        href={project.liveUrl}
                        target="_blank"
                        rel="noreferrer"
                        class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium text-green-300 transition border rounded-full bg-green-500/10 border-green-500/40 hover:bg-green-500/20 hover:text-green-200"
                      >
                        Ver proyecto
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke-width="1.5"
                          stroke="currentColor"
                          class="w-4 h-4"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"
                          />
                        </svg>
                      </a>
                    </div>
                    <ul class="flex flex-wrap gap-2 mt-4 text-xs text-gray-400 sm:text-sm">
                      {project.tags.map((tag) => (
                        <li
                          class="px-3 py-1 transition border rounded-full border-white/10 bg-white/5 text-gray-300/90"
                        >
                          {tag}
                        </li>
                      ))}
                    </ul>
                  </article>
                ))}
              </div>
            </div>

            <div class="relative flex flex-col gap-6 md:min-h-[440px] lg:min-h-[520px]">
              {projects.map((project, index) => (
                <ProjectWindow
                  title={project.title}
                  liveUrl={project.liveUrl}
                  windowClasses={`${zIndices[index] ?? "md:z-20"} ${project.windowClasses}`}
                />
              ))}
            </div>
          </div>

          <Tecnologias client:load />
        </section>
        </div>
      </div>
      <div
        class="container relative px-6 py-16 mx-auto md:py-24 lg:px-16 xl:px-10"
      >
        <section class="relative flex flex-col items-center" id="contacto">
          <h2 class="text-3xl font-semibold text-center text-white md:text-4xl">
            Contacto
          </h2>
          <p class="max-w-3xl mt-4 text-base leading-relaxed text-center text-gray-400 sm:text-lg">
            Si necesitas una web, tienes algún proyecto en mente que quieres
            lleva a cabo, o simplemente quieres hablar sobre temas tech, no
            dudes en contactar conmigo!
          </p>

          <div class="mt-10">
            <div class="grid gap-6 md:grid-cols-2">
              <div class="flex flex-col gap-2">
                <h3 class="text-lg font-medium text-center text-green-400 md:text-xl">
                  Información de contacto
                </h3>
                <div
                  class="flex items-center gap-4 p-4 transition-all duration-300 rounded-md bg-black-700 hover:scale-105"
                >
                  <div class="p-2 bg-green-500 rounded-sm text-gray-50">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.5"
                      stroke="currentColor"
                      class="size-6"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859M12 3v8.25m0 0-3-3m3 3 3-3"
                      ></path>
                    </svg>
                  </div>

                  <div>
                    <p class="text-sm font-medium text-gray-500">Email</p>
                    <p class="text-base text-gray-50">
                      josejavier.moreno.frz@gmail.com
                    </p>
                  </div>
                </div>
                <div class="">
                  <div
                    class="flex items-center gap-4 p-4 transition-all duration-300 rounded-md bg-black-700 hover:scale-105"
                  >
                    <div class="p-2 bg-green-500 rounded-sm text-gray-50">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="size-6"
                        width="25"
                        height="25"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
                        ></path>
                      </svg>
                    </div>

                    <div>
                      <p class="text-sm font-medium text-gray-500">Teléfono</p>
                      <p class="text-base text-gray-50">662092982</p>
                    </div>
                  </div>
                </div>

                <div class="">
                  <div
                    class="flex items-center gap-4 p-4 transition-all duration-300 rounded-md bg-black-700 hover:scale-105"
                  >
                    <div class="p-2 bg-green-500 rounded-sm text-gray-50">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="size-6"
                        width="25"
                        height="25"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                        ></path>
                      </svg>
                    </div>

                    <div>
                      <p class="text-sm font-medium text-gray-500">Ubicación</p>
                      <p class="text-base text-gray-50">Albacete</p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="w-full p-6 rounded-md bg-black-700">
                <form>
                  <h3 class="mb-6 text-xl font-semibold text-green-400 md:text-2xl">
                    Envíame un mensaje
                  </h3>
                  <fieldset class="grid w-full grid-cols-2 gap-4">
                    <div class="flex flex-col col-span-1">
                      <label for="name" class="text-sm font-medium text-gray-400">Nombre</label>
                      <input
                        type="text"
                        id="name"
                        class="px-3 py-2 mt-1 bg-gray-200 border-gray-600 border-solid rounded-md border-1 focus:outline-offset-0 focus:outline-green-600"
                      />
                    </div>
                    <div class="flex flex-col col-span-1">
                      <label for="email" class="text-sm font-medium text-gray-400">Email</label>
                      <input
                        type="email"
                        id="email"
                        class="px-3 py-2 mt-1 bg-gray-200 border-gray-600 border-solid rounded-md border-1 focus:outline-offset-0 focus:outline-green-600"
                      />
                    </div>
                    <div class="flex flex-col col-span-2">
                      <label for="subject" class="text-sm font-medium text-gray-400">Asunto</label>
                      <input
                        type="text"
                        id="subject"
                        class="px-3 py-2 mt-1 bg-gray-200 border-gray-600 border-solid rounded-md border-1 focus:outline-offset-0 focus:outline-green-600"
                      />
                    </div>
                    <div class="flex flex-col col-span-2">
                      <label for="message" class="text-sm font-medium text-gray-400">Mensaje</label>
                      <textarea
                        id="message"
                        class="px-3 py-2 mt-1 bg-gray-200 border-gray-600 border-solid rounded-md border-1 focus:outline-offset-0 focus:outline-green-600"
                      ></textarea>
                    </div>
                  </fieldset>
                  <button
                    type="submit"
                    class="w-full px-4 py-3 mt-6 text-sm font-medium text-center transition-all duration-200 ease-in rounded-md cursor-pointer md:text-base hover:bg-verde-btn-500 border-verde-btn-600 bg-verde-btn-700 text-gray-50"
                    >Enviar</button
                  >
                </form>
              </div>
            </div>
          </div>
        </section>
      </div>
      <ChatBot client:load/>
      <footer class="w-full py-8 border-t border-gray-800 bg-negro-900">
        <p class="text-sm text-center text-gray-400">
          &copy 2025 Jose Javier Moreno Clavijos - Todos los derechos
          reservados.
        </p>
      </footer>
    </main>
  </body>
</html>
