---
import "../styles/global.css";
import Header from "../components/Header.jsx";
import Sobremi from "../components/Sobremi.jsx";
import ChatBot from "../components/Chatbot.jsx";
import RotatingText from "../components/RotatingText";
import ScrollFloat from "../components/ScrollFloat.jsx";
import Tecnologias from "../components/Tecnologias.jsx";
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans bg-black-900">
    <Header client:load />
    <main class="relative min-h-screen" id="inicio">
      <div class="relative mt-16">
        <div
          class="container relative px-6 py-8 pt-8 pb-10 mx-auto md:py-24 lg:px-16 xl:px-20 md:pt-16"
        >
          <div class="relative">
            <div class="mx-auto">
              <div
                class="flex justify-center mx-auto text-center max-w-1xl md:max-w-3xl"
              >
                <div class="relative flex flex-col items-center">
                  <!-- Degradado radial verde claro, detrás del texto -->
                  <div
                    class="absolute inset-0 flex items-center justify-center pointer-events-none -z-10"
                    aria-hidden="true"
                  >
                    <div
                      class="w-[200px] h-[200px] md:w-[600px] md:h-[600px] rounded-full
      bg-[radial-gradient(circle,rgba(34,197,94,0.16)_0%,rgba(34,197,94,0.07)_20%,rgba(34,197,94,0)_60%)]"
                      style="top: 50%; left: 50%; transform: translate(-50%, -45%); position: absolute;"
                    >
                    </div>
                  </div>
                  <div class="flex flex-col items-center">
                    <h1
                      class="text-3xl text-center text-white sm:text-3xl md:text-6xl xl:text-7xl font-600"
                    >
                      <span class="block text-foreground">
                        Jose Javier Moreno
                      </span>
                      <span
                        class="relative inline-block w-[180px] md:w-[500px] h-[42px] md:h-[80px]"
                      >
                        <div
                          class="absolute inset-0 flex items-center justify-center gap-1 mt-1 md:gap-2"
                        >
                          Desarrollador
                          <RotatingText
                            client:load
                            texts={["Frontend", "Backend", "FullStack"]}
                            mainClassName="w-full h-full px-2 md:px-3 bg-green-400 text-black py-1 md:py-1 justify-center rounded-lg text-center whitespace-nowrap"
                            staggerFrom="last"
                            initial={{ y: "100%" }}
                            animate={{ y: 0 }}
                            exit={{ y: "-120%" }}
                            staggerDuration={0.025}
                            splitLevelClassName="overflow-hidden"
                            transition={{
                              type: "spring",
                              damping: 30,
                              stiffness: 400,
                            }}
                            rotationInterval={2300}
                          />
                        </div>
                      </span>
                    </h1>
                    <p class="pt-2 my-3 text-gray-200 text-md lg:text-xl">
                      Hola, soy Jose Javier. Desarrollador de software fullstack
                      con 2 años de experiencia. Me encanta crear soluciones
                      atractivas e innovadoras. Así como aplicaciones que ayuden
                      a mejorar la vida de las personas.
                    </p>
                  </div>
                  <div class="flex items-center justify-center gap-4 mt-10">
                    <a
                      class="relative flex inline-flex justify-center px-4 py-2 space-x-2 text-center text-white transition-all duration-200 ease-out border rounded-md outline-none text-md md:px-4 md:py-2 md:text-md font-regular bg-verde-btn-700 border-verde-btn-600 hover:bg-verde-btn-500 focus-visile:outline-4 focus:visible:outline-offset-1 focus-visible:ouline-green-600"
                      href="/images/CV - Jose Javier Moreno Clavijos.pdf"
                      class="btn btn-primary"
                      download>Descargar CV</a
                    >
                    <a
                      class="relative flex inline-flex justify-center px-4 py-2 space-x-2 text-center text-white transition-all duration-200 ease-out border border-green-100 rounded-md outline-none text-md md:text-md md:px-4 font-regular bg-verde-btn-400 focus-visile:outline-4 focus:visible:outline-offset-1 focus-visible:ouline-green-600"
                      href="#">Contactar</a
                    >
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="overflow-hidden">
            <div class="max-w-2xl mx-auto mt-20 fade-mask">
              <div
                class="flex space-x-8 text-white animate-marquee2 whitespace-nowrap lg:px-8"
              >
                <span class="text-md md:text-xl">🔍 Detallista</span>
                <span class="text-md md:text-xl">💡 Creativo</span>
                <span class="text-md md:text-xl">⚡ Proactivo</span>
                <span class="text-md md:text-xl">🛠️ Resolutivo</span>
                <span class="text-md md:text-xl">🧠 Autodidacta</span>
                <span class="text-md md:text-xl">🔍 Detallista</span>
                <span class="text-md md:text-xl">💡 Creativo</span>
                <span class="text-md md:text-xl">⚡ Proactivo</span>
                <span class="text-md md:text-xl">🛠️ Resolutivo</span>
                <span class="text-md md:text-xl">🧠 Autodidacta</span>
              </div>
            </div>
          </div>
        </div>

        <div
          class="container relative py-6 pt-8 pb-10 mx-auto px-7 md:py-16 md:px-14 lg:py-16 lg:px-16 xl:px-20 md:pt-16"
        >
          <Sobremi client:load />
        </div>

        <div
          class="container relative py-6 pt-8 pb-10 mx-auto px-7 md:py-16 md:px-14 lg:py-24 lg:px-20 xl:px-20 md:pt-16"
        >
          <section class="relative flex flex-col items-center" id="proyectos">

            <ScrollFloat client:load text="Proyectos"></ScrollFloat>

            <div class="relative w-full max-w-3xl mx-auto mt-12 group">
              <!-- Imagen -->
              <div class="overflow-hidden rounded-lg">
                <img
                  src="/images/portafolio.png"
                  alt="Proyecto"
                  class="object-cover w-full h-[440px] sm:h-[420px] md:h-[360px] lg:h-[320px] xl:h-[360px] transition"
                />
                <!-- Capa verde -->
                <div
                  class="absolute inset-0 transition bg-green-500/30 mix-blend-multiply group-hover:opacity-0"
                >
                </div>
              </div>

              <!-- Contenido -->
              <div
                class="absolute inset-0 flex flex-col items-center justify-center text-center px-4 py-8
      text-gray-200 bg-black-800/80 backdrop-blur-sm z-10
      lg:static lg:bg-transparent lg:backdrop-blur-none lg:items-end lg:justify-center lg:w-[60%] lg:ml-[40%] lg:pl-8 lg:py-8 lg:text-right lg:rounded-lg"
              >
                <p class="text-sm text-green-400">Proyecto Destacado</p>
                <h3 class="mt-1 text-2xl font-semibold text-white">
                  Halcyon Theme
                </h3>
                <p class="max-w-xs mt-3 text-sm leading-snug lg:max-w-md">
                  A minimal, dark blue theme for VS Code, Sublime Text, Atom,
                  iTerm, and more. Available on
                  <span class="text-teal-400 underline"
                    >Visual Studio Marketplace</span
                  >,
                  <span class="text-teal-400 underline">Package Control</span>,
                  <span class="text-teal-400 underline"
                    >Atom Package Manager</span
                  >, and
                  <span class="text-teal-400 underline">npm</span>.
                </p>
                <ul
                  class="flex flex-wrap justify-center gap-2 mt-4 text-xs text-gray-300 lg:justify-end"
                >
                  <li>VS Code</li>
                  <li>Sublime Text</li>
                  <li>Atom</li>
                  <li>iTerm2</li>
                  <li>Hyper</li>
                </ul>
                <ul
                  class="flex justify-center gap-4 mt-3 text-teal-400 lg:justify-end"
                >
                  <li>
                    <a href="#" class="transition hover:text-white">🔗</a>
                  </li>
                  <li>
                    <a href="#" class="transition hover:text-white">🔗</a>
                  </li>
                </ul>
              </div>
            </div>

            <Tecnologias client:load />
          </section>
        </div>
      </div>
      <div
        class="container relative px-6 py-16 pt-8 pb-10 mx-auto md:py-24 lg:px-16 xl:px-10 md:pt-0"
      >
        <section class="relative flex flex-col items-center" id="contacto">
          <h2 class="text-xl font-bold text-center text-white lg:text-3xl">
            Contacto
          </h2>
          <p class="max-w-3xl mt-2 text-center text-gray-400">
            Si necesitas una web, tienes algún proyecto en mente que quieres
            lleva a cabo, o simplemente quieres hablar sobre temas tech, no
            dudes en contactar conmigo!
          </p>

          <div class="mt-10">
            <div class="grid gap-6 md:grid-cols-2">
              <div class="flex flex-col gap-2">
                <h3 class="text-lg text-center text-green-400">
                  Información de contacto
                </h3>
                <div
                  class="flex items-center gap-4 p-4 transition-all duration-300 rounded-md bg-black-700 hover:scale-105"
                >
                  <div class="p-2 bg-green-500 rounded-sm text-gray-50">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.5"
                      stroke="currentColor"
                      class="size-6"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859M12 3v8.25m0 0-3-3m3 3 3-3"
                      ></path>
                    </svg>
                  </div>

                  <div>
                    <p class="text-sm text-gray-500">Email</p>
                    <p class="text-md text-gray-50">
                      josejavier.moreno.frz@gmail.com
                    </p>
                  </div>
                </div>
                <div class="">
                  <div
                    class="flex items-center gap-4 p-4 transition-all duration-300 rounded-md bg-black-700 hover:scale-105"
                  >
                    <div class="p-2 bg-green-500 rounded-sm text-gray-50">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="size-6"
                        width="25"
                        height="25"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
                        ></path>
                      </svg>
                    </div>

                    <div>
                      <p class="text-sm text-gray-500">Teléfono</p>
                      <p class="text-md text-gray-50">662092982</p>
                    </div>
                  </div>
                </div>

                <div class="">
                  <div
                    class="flex items-center gap-4 p-4 transition-all duration-300 rounded-md bg-black-700 hover:scale-105"
                  >
                    <div class="p-2 bg-green-500 rounded-sm text-gray-50">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="size-6"
                        width="25"
                        height="25"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                        ></path>
                      </svg>
                    </div>

                    <div>
                      <p class="text-sm text-gray-500">Ubicación</p>
                      <p class="text-sm text-gray-50">Albacete</p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="w-full p-4 rounded-md bg-black-700">
                <form>
                  <h3 class="mb-4 text-green-400 md:text-lg">
                    Envíame un mensaje
                  </h3>
                  <fieldset class="grid w-full grid-cols-2 gap-4">
                    <div class="flex flex-col col-span-1">
                      <label for="name" class="text-gray-400">Nombre</label>
                      <input
                        type="text"
                        id="name"
                        class="px-3 py-2 mt-1 bg-gray-200 border-gray-600 border-solid rounded-md border-1 focus:outline-offset-0 focus:outline-green-600"
                      />
                    </div>
                    <div class="flex flex-col col-span-1">
                      <label for="email" class="text-gray-400">Email</label>
                      <input
                        type="email"
                        id="email"
                        class="px-3 py-2 mt-1 bg-gray-200 border-gray-600 border-solid rounded-md border-1 focus:outline-offset-0 focus:outline-green-600"
                      />
                    </div>
                    <div class="flex flex-col col-span-2">
                      <label for="subject" class="text-gray-400">Asunto</label>
                      <input
                        type="text"
                        id="subject"
                        class="px-3 py-2 mt-1 bg-gray-200 border-gray-600 border-solid rounded-md border-1 focus:outline-offset-0 focus:outline-green-600"
                      />
                    </div>
                    <div class="flex flex-col col-span-2">
                      <label for="message" class="text-gray-400">Mensaje</label>
                      <textarea
                        id="message"
                        class="px-3 py-2 mt-1 bg-gray-200 border-gray-600 border-solid rounded-md border-1 focus:outline-offset-0 focus:outline-green-600"
                      ></textarea>
                    </div>
                  </fieldset>
                  <button
                    type="submit"
                    class="w-full mt-4 text-center transition-all duration-200 ease-in rounded-md cursor-pointer hover:bg-verde-btn-500 md:px-4 md:py-2 md:text-sm border-verde-btn-600 bg-verde-btn-700 text-gray-50"
                    >Enviar</button
                  >
                </form>
              </div>
            </div>
          </div>
        </section>
      </div>
      <ChatBot client:load/>
      <footer class="w-full py-8 border-t border-gray-800 bg-negro-900">
        <p class="text-sm text-center text-gray-400">
          &copy 2025 Jose Javier Moreno Clavijos - Todos los derechos
          reservados.
        </p>
      </footer>
    </main>
  </body>
</html>
