---
import "../styles/global.css";
import Header from "../components/Header.jsx";
import Sobremi from "../components/Sobremi.jsx";
import ChatBot from "../components/Chatbot.jsx";
import RotatingText from "../components/RotatingText";
import ScrollFloat from "../components/ScrollFloat.jsx";
import Tecnologias from "../components/Tecnologias.jsx";
import LiquidEther from "../components/LiquidEther.jsx";
import { projects } from "../lib/projects";
import ProjectWindow from "../components/ProjectWindow.astro";
const zIndices = ["md:z-30", "md:z-40", "md:z-20", "md:z-10"];
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans bg-black-900">
    <Header client:load />
    <main class="relative min-h-screen" id="inicio">
      <section class="relative mt-14 md:mt-0">
        <div class="absolute inset-0 overflow-hidden -z-10">
          <LiquidEther
            client:load
            colors={["#5227FF", "#FF9FFC", "#B19EEF"]}
            mouseForce={20}
            cursorSize={100}
            isViscous={false}
            viscous={30}
            iterationsViscous={32}
            iterationsPoisson={32}
            resolution={0.5}
            isBounce={false}
            autoDemo={true}
            autoSpeed={0.5}
            autoIntensity={2.2}
            takeoverDuration={0.25}
            autoResumeDelay={3000}
            autoRampDuration={0.6}
          />

          <div
            class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/40 to-black/90 backdrop-blur-[2px] pointer-events-none"
            aria-hidden="true"
          >
          </div>
        </div>
        <div
          class="container relative px-6 py-12 mx-auto md:py-20 lg:px-16 xl:px-20"
        >
          <div class="relative">
            <div class="mx-auto">
              <div
                class="flex justify-center mx-auto text-center max-w-1xl md:max-w-3xl"
              >
                <div class="relative flex flex-col items-center">
                  <!-- Degradado radial verde claro, detrás del texto -->
                  <div
                    class="absolute inset-0 flex items-center justify-center pointer-events-none -z-10"
                    aria-hidden="true"
                  >
                    <div
                      class="w-[200px] h-[200px] md:w-[600px] md:h-[600px] rounded-full
      bg-[radial-gradient(circle,rgba(34,197,94,0.16)_0%,rgba(34,197,94,0.07)_20%,rgba(34,197,94,0)_60%)]"
                      style="top: 50%; left: 50%; transform: translate(-50%, -45%); position: absolute;"
                    >
                    </div>
                  </div>
                  <div class="flex flex-col items-center">
                    <h1
                      class="text-4xl font-semibold text-center text-white sm:text-5xl md:text-6xl xl:text-7xl"
                    >
                      <span class="block text-foreground">
                        Jose Javier Moreno
                      </span>
                      <span
                        class="relative inline-block w-[180px] md:w-[500px] h-[42px] md:h-[80px]"
                      >
                        <div
                          class="absolute inset-0 flex items-center justify-center gap-1 mt-1 md:gap-2"
                        >
                          Desarrollador
                          <RotatingText
                            client:load
                            texts={["Frontend", "Backend", "FullStack"]}
                            mainClassName="w-full h-full px-2 md:px-3 bg-green-400 text-black py-1 md:py-1 justify-center rounded-lg text-center whitespace-nowrap"
                            staggerFrom="last"
                            initial={{ y: "100%" }}
                            animate={{ y: 0 }}
                            exit={{ y: "-120%" }}
                            staggerDuration={0.025}
                            splitLevelClassName="overflow-hidden"
                            transition={{
                              type: "spring",
                              damping: 30,
                              stiffness: 400,
                            }}
                            rotationInterval={2300}
                          />
                        </div>
                      </span>
                    </h1>
                    <p
                      class="pt-4 my-4 text-base leading-relaxed text-gray-200 sm:text-lg lg:text-xl"
                    >
                      Hola, soy Jose Javier. Desarrollador de software fullstack
                      con 2 años de experiencia. Me encanta crear soluciones
                      atractivas e innovadoras. Así como aplicaciones que ayuden
                      a mejorar la vida de las personas.
                    </p>
                  </div>
                  <div class="flex items-center justify-center gap-4 mt-10">
                    <a
                      class="relative flex inline-flex justify-center px-5 py-2 space-x-2 text-sm font-medium text-center text-white transition-all duration-200 ease-out border rounded-md outline-none md:px-5 md:py-3 md:text-base bg-verde-btn-700 border-verde-btn-600 hover:bg-verde-btn-500 focus-visile:outline-4 focus:visible:outline-offset-1 focus-visible:ouline-green-600"
                      href="/images/CV - Jose Javier Moreno Clavijos.pdf"
                      class="btn btn-primary"
                      download>Descargar CV</a
                    >
                    <a
                      class="relative flex inline-flex justify-center px-5 py-2 space-x-2 text-sm font-medium text-center text-white transition-all duration-200 ease-out border border-green-100 rounded-md outline-none md:text-base md:px-5 bg-verde-btn-400 focus-visile:outline-4 focus:visible:outline-offset-1 focus-visible:ouline-green-600"
                      href="#">Contactar</a
                    >
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="overflow-hidden">
            <div class="max-w-2xl mx-auto mt-16 md:mt-20 fade-mask">
              <div
                class="flex space-x-8 text-white animate-marquee2 whitespace-nowrap lg:px-8"
              >
                <span class="text-sm sm:text-base md:text-lg"
                  >🔍 Detallista</span
                >
                <span class="text-sm sm:text-base md:text-lg">💡 Creativo</span>
                <span class="text-sm sm:text-base md:text-lg">⚡ Proactivo</span
                >
                <span class="text-sm sm:text-base md:text-lg"
                  >🛠️ Resolutivo</span
                >
                <span class="text-sm sm:text-base md:text-lg"
                  >🧠 Autodidacta</span
                >
                <span class="text-sm sm:text-base md:text-lg"
                  >🔍 Detallista</span
                >
                <span class="text-sm sm:text-base md:text-lg">💡 Creativo</span>
                <span class="text-sm sm:text-base md:text-lg">⚡ Proactivo</span
                >
                <span class="text-sm sm:text-base md:text-lg"
                  >🛠️ Resolutivo</span
                >
                <span class="text-sm sm:text-base md:text-lg"
                  >🧠 Autodidacta</span
                >
              </div>
            </div>
          </div>
        </div>
      </section>

      <div
        class="container relative py-12 mx-auto px-7 md:py-20 md:px-14 lg:px-16 xl:px-20"
      >
        <Sobremi client:load />
      </div>

      <div
        class="container relative py-12 mx-auto px-7 md:py-20 md:px-14 lg:py-24 lg:px-20 xl:px-20"
      >
        <section class="relative flex flex-col items-center" id="proyectos">
          <ScrollFloat client:load text="Proyectos" />

          <div class="grid w-full gap-12 mt-20 lg:items-center">
            <div
              class="relative flex flex-col gap-6 md:min-h-[200px] lg:min-h-[300px]"
            >
              {
                projects.map((project, index) => (
                  <ProjectWindow
                    title={project.title}
                    liveUrl={project.liveUrl}
                    windowClasses={`${zIndices[index] ?? "md:z-20"} ${project.windowClasses}`}
                  />
                ))
              }
            </div>
          </div>
        </section>
      </div>
      <Tecnologias client:load />
    </main>

    <div
      class="container relative px-6 py-16 mx-auto md:py-24 lg:px-16 xl:px-10"
    >
      <section class="relative flex flex-col items-center" id="contacto">

        <h2 class="text-3xl font-semibold text-center text-white md:text-4xl">
          Contacto
        </h2>
        <p
          class="max-w-3xl mt-4 text-base leading-relaxed text-center text-gray-400 sm:text-lg"
        >
          Si necesitas una web, tienes algún proyecto en mente que quieres lleva
          a cabo, o simplemente quieres hablar sobre temas tech, no dudes en
          contactar conmigo!
        </p>

        <div class="mt-10">
          <div class="grid gap-6 md:grid-cols-2">
            <div class="flex flex-col gap-2">
              <h3
                class="text-lg font-medium text-center text-green-400 md:text-xl"
              >
                Información de contacto
              </h3>
              <div
                class="flex items-center gap-4 p-4 transition-all duration-300 rounded-md bg-black-700 hover:scale-105"
              >
                <div class="p-2 bg-green-500 rounded-sm text-gray-50">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="size-6"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859M12 3v8.25m0 0-3-3m3 3 3-3"
                    ></path>
                  </svg>
                </div>

                <div>
                  <p class="text-sm font-medium text-gray-500">Email</p>
                  <p class="text-base text-gray-50">
                    josejavier.moreno.frz@gmail.com
                  </p>
                </div>
              </div>
              <div class="">
                <div
                  class="flex items-center gap-4 p-4 transition-all duration-300 rounded-md bg-black-700 hover:scale-105"
                >
                  <div class="p-2 bg-green-500 rounded-sm text-gray-50">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.5"
                      stroke="currentColor"
                      class="size-6"
                      width="25"
                      height="25"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
                      ></path>
                    </svg>
                  </div>

                  <div>
                    <p class="text-sm font-medium text-gray-500">Teléfono</p>
                    <p class="text-base text-gray-50">662092982</p>
                  </div>
                </div>
              </div>

              <div class="">
                <div
                  class="flex items-center gap-4 p-4 transition-all duration-300 rounded-md bg-black-700 hover:scale-105"
                >
                  <div class="p-2 bg-green-500 rounded-sm text-gray-50">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.5"
                      stroke="currentColor"
                      class="size-6"
                      width="25"
                      height="25"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                      ></path>
                    </svg>
                  </div>

                  <div>
                    <p class="text-sm font-medium text-gray-500">Ubicación</p>
                    <p class="text-base text-gray-50">Albacete</p>
                  </div>
                </div>

              </div>
            </div>
            <div class="w-full p-6 rounded-md">
              <form
                class="grid gap-5 p-6 transition-all duration-300 border rounded-xl shadow-lg bg-black-700/70 border-black-600/80 backdrop-blur"
              >
                <div class="grid gap-5 md:grid-cols-2">
                  <div class="flex flex-col gap-2">
                    <label
                      for="contact-name"
                      class="text-sm font-medium uppercase tracking-wide text-gray-400"
                    >
                      Nombre completo
                    </label>
                    <input
                      id="contact-name"
                      type="text"
                      name="name"
                      placeholder="Tu nombre"
                      class="px-4 py-3 text-sm transition-colors border rounded-lg bg-black-800/60 border-black-600 text-gray-100 placeholder:text-gray-500 focus:border-green-500 focus:outline-none focus:ring-2 focus:ring-green-500/40"
                      required
                    />
                  </div>
                  <div class="flex flex-col gap-2">
                    <label
                      for="contact-email"
                      class="text-sm font-medium uppercase tracking-wide text-gray-400"
                    >
                      Correo electrónico
                    </label>
                    <input
                      id="contact-email"
                      type="email"
                      name="email"
                      placeholder="tu@email.com"
                      class="px-4 py-3 text-sm transition-colors border rounded-lg bg-black-800/60 border-black-600 text-gray-100 placeholder:text-gray-500 focus:border-green-500 focus:outline-none focus:ring-2 focus:ring-green-500/40"
                      required
                    />
                  </div>
                </div>

                <div class="flex flex-col gap-2">
                  <label
                    for="contact-subject"
                    class="text-sm font-medium uppercase tracking-wide text-gray-400"
                  >
                    Asunto
                  </label>
                  <input
                    id="contact-subject"
                    type="text"
                    name="subject"
                    placeholder="¿Sobre qué quieres hablar?"
                    class="px-4 py-3 text-sm transition-colors border rounded-lg bg-black-800/60 border-black-600 text-gray-100 placeholder:text-gray-500 focus:border-green-500 focus:outline-none focus:ring-2 focus:ring-green-500/40"
                  />
                </div>

                <div class="flex flex-col gap-2">
                  <label
                    for="contact-message"
                    class="text-sm font-medium uppercase tracking-wide text-gray-400"
                  >
                    Mensaje
                  </label>
                  <textarea
                    id="contact-message"
                    name="message"
                    rows="5"
                    placeholder="Cuéntame más sobre tu proyecto, idea o duda"
                    class="px-4 py-3 text-sm transition-colors border rounded-lg resize-none bg-black-800/60 border-black-600 text-gray-100 placeholder:text-gray-500 focus:border-green-500 focus:outline-none focus:ring-2 focus:ring-green-500/40"
                    required
                  ></textarea>
                </div>

                <button
                  type="submit"
                  class="px-6 py-3 text-sm font-semibold tracking-wide text-center text-white transition-colors rounded-lg bg-green-500 hover:bg-green-600 focus:outline-none focus:ring-4 focus:ring-green-500/30"
                >
                  Enviar mensaje
                </button>
              </form>

              <div class="flex flex-col items-center gap-4 mt-8">
                <p class="text-sm font-medium tracking-wide text-gray-400 uppercase">
                  También puedes encontrarme en
                </p>
                <div class="flex items-center justify-center gap-4">
                  <a
                    href="https://github.com/JJavier-Moreno"
                    target="_blank"
                    rel="noopener noreferrer"
                    class=""
                    aria-label="GitHub"
                  >
                    <div class="p-3 transition rounded-full bg-gray-800 hover:bg-green-500">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        x="0px"
                        y="0px"
                        width="24"
                        height="24"
                        fill="currentColor"
                        viewBox="0 0 30 30"
                      >
                        <path d="M15,3C8.373,3,3,8.373,3,15c0,5.623,3.872,10.328,9.092,11.63C12.036,26.468,12,26.28,12,26.047v-2.051 c-0.487,0-1.303,0-1.508,0c-0.821,0-1.551-0.353-1.905-1.009c-0.393-0.729-0.461-1.844-1.435-2.526 c-0.289-0.227-0.069-0.486,0.264-0.451c0.615,0.174,1.125,0.596,1.605,1.222c0.478,0.627,0.703,0.769,1.596,0.769 c0.433,0,1.081-0.025,1.691-0.121c0.328-0.833,0.895-1.6,1.588-1.962c-3.996-0.411-5.903-2.399-5.903-5.098 c0-1.162,0.495-2.286,1.336-3.233C9.053,10.647,8.706,8.73,9.435,8c1.798,0,2.885,1.166,3.146,1.481C13.477,9.174,14.461,9,15.495,9 c1.036,0,2.024,0.174,2.922,0.483C18.675,9.17,19.763,8,21.565,8c0.732,0.731,0.381,2.656,0.102,3.594 c0.836,0.945,1.328,2.066,1.328,3.226c0,2.697-1.904,4.684-5.894,5.097C18.199,20.49,19,22.1,19,23.313v2.734 c0,0.104-0.023,0.179-0.035,0.268C23.641,24.676,27,20.236,27,15C27,8.373,21.627,3,15,3z"></path>
                      </svg>
                    </div>
                  </a>
                  <a
                    href="https://www.linkedin.com/in/jose-javier-moreno/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class=""
                    aria-label="LinkedIn"
                  >
                    <div class="p-3 transition rounded-full bg-gray-800 hover:bg-blue-500">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        x="0px"
                        y="0px"
                        width="24"
                        height="24"
                        fill="currentColor"
                        viewBox="0 0 50 50"
                      >
                        <path d="M 9 4 C 6.2504839 4 4 6.2504839 4 9 L 4 41 C 4 43.749516 6.2504839 46 9 46 L 41 46 C 43.749516 46 46 43.749516 46 41 L 46 9 C 46 6.2504839 43.749516 4 41 4 L 9 4 z M 9 6 L 41 6 C 42.668484 6 44 7.3315161 44 9 L 44 41 C 44 42.668484 42.668484 44 41 44 L 9 44 C 7.3315161 44 6 42.668484 6 41 L 6 9 C 6 7.3315161 7.3315161 6 9 6 z M 14 11.011719 C 12.904779 11.011719 11.919219 11.339079 11.189453 11.953125 C 10.459687 12.567171 10.011719 13.484511 10.011719 14.466797 C 10.011719 16.333977 11.631285 17.789609 13.691406 17.933594 A 0.98809878 0.98809878 0 0 0 13.695312 17.935547 A 0.98809878 0.98809878 0 0 0 14 17.988281 C 16.27301 17.988281 17.988281 16.396083 17.988281 14.466797 A 0.98809878 0.98809878 0 0 0 17.986328 14.414062 C 17.884577 12.513831 16.190443 11.011719 14 11.011719 z M 14 12.988281 C 15.392231 12.988281 15.94197 13.610038 16.001953 14.492188 C 15.989803 15.348434 15.460091 16.011719 14 16.011719 C 12.614594 16.011719 11.988281 15.302225 11.988281 14.466797 C 11.988281 14.049083 12.140703 13.734298 12.460938 13.464844 C 12.78117 13.19539 13.295221 12.988281 14 12.988281 z M 11 19 A 1.0001 1.0001 0 0 0 10 20 L 10 39 A 1.0001 1.0001 0 0 0 11 40 L 17 40 A 1.0001 1.0001 0 0 0 18 39 L 18 33.134766 L 18 20 A 1.0001 1.0001 0 0 0 17 19 L 11 19 z M 20 19 A 1.0001 1.0001 0 0 0 19 20 L 19 39 A 1.0001 1.0001 0 0 0 20 40 L 26 40 A 1.0001 1.0001 0 0 0 27 39 L 27 29 C 27 28.170333 27.226394 27.345035 27.625 26.804688 C 28.023606 26.264339 28.526466 25.940057 29.482422 25.957031 C 30.468166 25.973981 30.989999 26.311669 31.384766 26.841797 C 31.779532 27.371924 32 28.166667 32 29 L 32 39 A 1.0001 1.0001 0 0 0 33 40 L 39 40 A 1.0001 1.0001 0 0 0 40 39 L 40 28.261719 C 40 25.300181 39.122788 22.95433 37.619141 21.367188 C 36.115493 19.780044 34.024172 19 31.8125 19 C 29.710483 19 28.110853 19.704889 27 20.423828 L 27 20 A 1.0001 1.0001 0 0 0 26 19 L 20 19 z M 12 21 L 16 21 L 16 33.134766 L 16 38 L 12 38 L 12 21 z M 21 21 L 25 21 L 25 22.560