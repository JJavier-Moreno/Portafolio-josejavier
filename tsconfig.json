{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "reactbits": ["./src/lib/reactbits/index.js"],
      "reactbits/*": ["./src/lib/reactbits/*"]
    }
  }
}
